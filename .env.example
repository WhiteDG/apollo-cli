# Apollo CLI 凭据模板
# 复制为 .env 后填入真实凭据：cp .env.example .env

# 方式一：全局凭据（所有 profile 共用）
# APOLLO_USERNAME=your_username
# APOLLO_PASSWORD=your_password

# 方式二：按 profile 专属凭据（profile 名大写，非字母数字转下划线）
# profile dev 的凭据：
# APOLLO_DEV_USERNAME=your_dev_username
# APOLLO_DEV_PASSWORD=your_dev_password

# profile fat 的凭据：
# APOLLO_FAT_USERNAME=your_fat_username
# APOLLO_FAT_PASSWORD=your_fat_password

# profile test 的凭据：
# APOLLO_TEST_USERNAME=your_test_username
# APOLLO_TEST_PASSWORD=your_test_password

# 优先级：profile 专属 > 全局；命令行 --username/--password 优先级最高
# 注意：shell 环境变量优先于 .env 文件